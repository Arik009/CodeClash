MONGO_URL=mongodb://app:codeclash@127.0.0.1:27017/codeclash?replicaSet=rs0&authSource=codeclash
AUDIT_MONGO_URL=mongodb://auditWriter:codeclash@127.0.0.1:27017/codeclash_audit?replicaSet=rs0&authSource=codeclash_audit
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=change-me-in-local-env
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JUDGE_SLOTS=4
# 1 runs every test of a submission in one container after a single compile.
JUDGE_BATCH=0

# Test hardening runs without a model. To add the optional AI planner, set a provider and a model:
#   anthropic (ANTHROPIC_API_KEY), gemini (GEMINI_API_KEY), or openai (OPENAI_API_KEY, or
#   AGENT_BASE_URL for any OpenAI-compatible server such as a local Ollama at http://localhost:11434/v1).
AGENT_PROVIDER=
AGENT_MODEL=
AGENT_BASE_URL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Tokens one hardening run may spend, and the monthly ceiling across runs.
AGENT_RUN_TOKEN_CAP=20000
AGENT_MONTHLY_TOKEN_CAP=200000
